# ─── Aplicación ──────────────────────────────────────────────
APP_NAME=BALTAE
APP_BASE_URL=https://granja.baltae.com
APP_ENV=production
APP_DEBUG=false

# ─── Base de datos ───────────────────────────────────────────
DB_HOST=localhost
DB_NAME=granja_app
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ─── Correo SMTP ─────────────────────────────────────────────
MAIL_ENABLED=true
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="APP BALTAE"
MAIL_SMTP_HOST=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=ssl

# ─── Anthropic API (Claude Vision) ───────────────────────────
ANTHROPIC_API_KEY=
