# ─── Rewrite: enrutar todo a index.php ─────────────────────────
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# ─── Bloquear archivos sensibles ──────────────────────────────
# Dotfiles (.env, .git, .htaccess, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Archivos de configuración y similares
<FilesMatch "^(config\.php|config\.local\.php|composer\.(json|lock)|package(-lock)?\.json|README\.md|CLAUDE\.md|diagnostico_recevet\.php)$">
    Require all denied
</FilesMatch>

# ─── Bloquear acceso directo a carpetas de código ────────────
RedirectMatch 403 ^/app/.*$
RedirectMatch 403 ^/database/.*$
RedirectMatch 403 ^/sql/.*$
RedirectMatch 403 ^/logs/.*$
RedirectMatch 403 ^/scripts/.*$

# ─── Cache de assets estáticos ────────────────────────────────
# Imágenes, fuentes, CSS y JS que no cambian a diario. El navegador los
# cachea 1 año (immutable). Si actualizamos un asset, conviene cambiar el
# nombre o añadir ?v= al import; mientras tanto, una recarga forzada
# (Cmd+Shift+R) invalida el cache.
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|css|js|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
